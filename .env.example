# Frame orders from /frames are written into the Sparrow Sales Pipeline in
# Notion. Copy this file to .env.local for development, and set the same two
# values in your host's environment variables for production.
#
# Both are read server-side only (app/api/frame-order/route.js). Never prefix
# them with NEXT_PUBLIC_ — that would ship the token to every visitor.
#
# To get the token:
#   1. notion.so/my-integrations → New integration → internal
#   2. Copy the Internal Integration Secret into NOTION_TOKEN below
#   3. Open the Sparrow Sales Pipeline database in Notion → ••• → Connections
#      → add the integration. It only needs access to that one database.
#
# Without these set, the order form falls back to sending on WhatsApp.

NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 🎁 Sparrow Sales Pipeline (PMC-22)
NOTION_DATABASE_ID=316d45c8-15c5-8008-8642-cbf3b8b32fc4
